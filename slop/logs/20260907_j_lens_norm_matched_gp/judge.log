e as real, but adds flattery.", "on_axis_A": 3.2, "on_axis_B": 4.1, "off_axis_A": 0.4, "off_axis_B": 1.2, "on_axis_A_minus_B": -0.8999999999999995, "off_axis_A_minus_B": -0.7999999999999999}, "provider": "Parasail", "quant": ["fp8", "int8", "bf16", "fp16"], "cost_usd": 0.00015946, "condition": "norm_matched_gp_plus", "exported_effect": 0.8999999999999995}
