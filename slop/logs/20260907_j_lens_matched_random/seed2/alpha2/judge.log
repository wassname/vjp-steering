_axis_A_minus_B": -0.09999999999999998}, "provider": "Parasail", "quant": ["fp8", "int8", "bf16", "fp16"], "cost_usd": 0.00015862, "condition": "random_s2_a2_+C", "exported_effect": 0.20000000000000018}
