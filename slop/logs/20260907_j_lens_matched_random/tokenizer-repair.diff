+def tokenizer_and_hook_check():
+    from huggingface_hub import snapshot_download
+    from transformers import Qwen3_5TextConfig, Qwen3_5ForCausalLM
+    source,_=additive.source_contrast()
+    reference=json.loads(norm.REFERENCE.read_text())
+    snapshot=Path(snapshot_download(gap.MODEL,revision=gap.REVISION,allow_patterns=['*token*','*.json'],local_files_only=True))
+    tokenizer=additive.generation_tokenizer(snapshot,source,reference)
+    rows,_=gap.walk.read_cohort(15)
+    for row in rows:
+        bare=next(r for r in reference['records'] if r['scenario']==row['scenario'] and r['condition']=='bare')
+        rendered=gap.walk.generation_inputs(tokenizer,[row])[0]
+        encoded=tokenizer(rendered,return_tensors='pt',add_special_tokens=False)
+        assert rendered==bare['rendered'] and encoded.input_ids[0].tolist()==bare['input_ids']
+        expected_mask=bare.get('attention_mask',[1]*len(bare['input_ids']))
+        assert encoded.attention_mask[0].tolist()==expected_mask
+        print('DEV_INPUT_PARITY',json.dumps({'scenario':row['scenario'],'input_ids':encoded.input_ids[0].tolist(),'attention_mask':expected_mask}),flush=True)
+    config=Qwen3_5TextConfig(vocab_size=64,hidden_size=32,intermediate_size=64,num_hidden_layers=3,
+        num_attention_heads=2,num_key_value_heads=1,head_dim=16,layer_types=['linear_attention','full_attention','linear_attention'],
+        linear_num_key_heads=2,linear_num_value_heads=2,linear_key_head_dim=8,linear_value_head_dim=8,pad_token_id=0,eos_token_id=63)
+    torch.manual_seed(17);model=Qwen3_5ForCausalLM(config).eval()
+    g=torch.randn(32,generator=torch.Generator().manual_seed(0));v=g/(g.norm()+1e-8)*.7216137051582336
+    inputs={'input_ids':torch.tensor([[1,2,3,4]]),'attention_mask':torch.ones(1,4,dtype=torch.long)}
+    def generate():return model.generate(**inputs,max_new_tokens=4,do_sample=False,use_cache=True)
+    with torch.inference_mode():
+        bare=generate()
+        for sign in (-1,1):
+            for alpha in (0,1,2,4):
+                ms=[]
+                with additive.intervention(model,v,sign*alpha,ms,layer=1):out=generate()
+                assert len(ms)==out.shape[1]-4 and all(m['next_block_exact'] and m['nonfinal_exact'] for m in ms)
+                assert [m['sequence_length'] for m in ms]==[4]+[1]*(len(ms)-1)
+                if alpha:assert all(m['actual_norm']>0 and m['direction_cosine']>.99 for m in ms)
+                else:assert torch.equal(out,bare) and all(m['actual_norm']==0 for m in ms)
+        assert torch.equal(generate(),bare)
+    print('TOKENIZER_AND_REAL_HYBRID_HOOK_PASS all15 IDs/masks;alpha0/1/2/4;bothsigns;nextblock;cachedschedule;cleanup',flush=True)
+
