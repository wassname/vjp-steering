ricated methodology.", "on_axis_A": 3.8, "on_axis_B": 3.5, "off_axis_A": 0.2, "off_axis_B": 0.4, "on_axis_A_minus_B": 0.2999999999999998, "off_axis_A_minus_B": -0.2}, "provider": "Parasail", "quant": ["fp8", "int8", "bf16", "fp16"], "cost_usd": 0.00015834, "condition": "random_s0_a4_+C", "exported_effect": -0.2999999999999998}
