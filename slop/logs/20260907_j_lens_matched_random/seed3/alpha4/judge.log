: 0.8, "off_axis_B": 1.2, "on_axis_A_minus_B": -0.2999999999999998, "off_axis_A_minus_B": -0.3999999999999999}, "provider": "Parasail", "quant": ["fp8", "int8", "bf16", "fp16"], "cost_usd": 0.00015526, "condition": "random_s3_a4_+C", "exported_effect": -0.2999999999999998}
