 "off_axis_A_minus_B": -0.4}, "provider": "Parasail", "quant": ["fp8", "int8", "bf16", "fp16"], "cost_usd": 0.0001582, "condition": "random_s3_a4_+C", "exported_effect": 0.2999999999999998}
